# ──────────────────────────────────────────────────────────────
# PhFlow Configuration  —  every setting lives here
# Pydantic-settings reads these automatically; restart the API
# server after changes.
# ──────────────────────────────────────────────────────────────

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64

# ── FAISS Vector Store ───────────────────────────────────────
FAISS_INDEX_DIR=faiss_index

# ── LLM (llama.cpp server) ───────────────────────────────────
# Start with: llama-server -m /path/to/model.gguf -c 32768 --port 8080
# Backend: "llamacpp" or "ollama"
LLM_BACKEND=llamacpp
OLLAMA_MODEL=qwen3.5
LLAMA_CPP_URL=http://localhost:8080
LLAMA_CPP_TEMPERATURE=0.1
LLAMA_CPP_NUM_CTX=32768
LLAMA_CPP_MAX_TOKENS=768
LLAMA_CPP_REPEAT_PENALTY=1.1
LLAMA_CPP_REPEAT_LAST_N=256
LLAMA_CPP_FREQUENCY_PENALTY=0.1
LLAMA_CPP_TOP_P=0.9
LLAMA_CPP_QUERY_REWRITE_TOKENS=128

# ── Retrieval Pipeline ───────────────────────────────────────
INITIAL_RETRIEVAL_K=10
RETRIEVAL_TOP_N=5
PREFETCH_MULTIPLIER=2
ENABLE_QUERY_REWRITE=true
# Restrict retrieval to these CFR parts; leave empty to search all
SCOPE_PART_NUMBERS=[210,211]

# ── Sessions ─────────────────────────────────────────────────
SESSION_MAX_MESSAGES=100
# Set to a Redis URL to enable persistent sessions (e.g. redis://localhost:6379)
# REDIS_URL=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins; set to ["*"] for dev only
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ── Chunking ─────────────────────────────────────────────────
CHUNK_MAX_TOKENS=512

# ── Prompt ───────────────────────────────────────────────────
SYSTEM_PROMPT_PATH=prompts/system_prompt.txt

# ── Data Paths ───────────────────────────────────────────────
XML_PATH=data/ecfr-title-21/ECFR-title21.xml
VERSIONS_PATH=data/ecfr-title-21/versions-title-21.json

