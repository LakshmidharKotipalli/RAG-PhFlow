# Embedding
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64

# Qdrant
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=ecfr_title21

# llama.cpp server (start with: llama-server -m /path/to/model.gguf -c 32768 --port 8080)
LLAMA_CPP_URL=https://localhost:8080

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval
INITIAL_RETRIEVAL_K=10
RERANKER_TOP_N=5
RERANKER_SCORE_THRESHOLD=0.25

# Chunking (overflow guard for structural chunking; sets max tokens per paragraph group)
CHUNK_MAX_TOKENS=512

# Data paths
XML_PATH=data/ecfr-title-21/ECFR-title21.xml
VERSIONS_PATH=data/ecfr-title-21/versions-title-21.json