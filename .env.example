# Embedding
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64

# Qdrant
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=ecfr_title21

# llama.cpp server (start with: llama-server -m /path/to/model.gguf -c 65536 --port 8080)
LLAMA_CPP_URL=http://localhost:8080
LLAMA_CPP_TEMPERATURE=0.1
LLAMA_CPP_NUM_CTX=65536
LLAMA_CPP_MAX_TOKENS=2048

# Reranker
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Retrieval
INITIAL_RETRIEVAL_K=40
RERANKER_TOP_N=5
RERANKER_SCORE_THRESHOLD=0.0

# Chunking
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=512

# Data paths
XML_PATH=data/ecfr-title-21/ECFR-title21.xml
VERSIONS_PATH=data/ecfr-title-21/versions-title-21.json
